#!/bin/bash

set -e

# Get this file absolute path
GSWA_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${GSWA_SCRIPT_DIR}/git_utils.sh"
source "${GSWA_SCRIPT_DIR}/odoo_utils.sh"
source "${GSWA_SCRIPT_DIR}/config.sh"

if [[ $# -eq 0 ]]; then
    branch=$(select_get_branch)
else
    branch=$1
fi
echo $branch
branch_source=$(get_branch_source $branch)

if [[ $branch_source != $branch ]]; then
    cdodoo
    exit_status=$?
    if [[ $exit_status -ne 0 ]]; then
        exit $exit_status
    fi
    community_exists=$(local_branch_exists $branch)
    cd ../$enterprise_folder
    enterprise_exists=$(local_branch_exists $branch)
    if [[ $community_exists -eq 0 && $enterprise_exists -eq 0 ]]; then
        echo Could not find the branch locally, searching in remote 'dev' ...
        enterprise_exists=$(remote_branch_exists $branch)
        if [[ $enterprise_exists -eq 1 ]]; then
            git fetch dev $branch
        fi

        cd ../$community_folder
        community_exists=$(remote_branch_exists $branch)
        if [[ $community_exists -eq 1 ]]; then
            git fetch dev $branch
        fi

        if [[ $community_exists -eq 0 && $enterprise_exists -eq 0 ]]; then
            echo Could not find the branch $branch neither locally, neither on the remote 1>&2
            exit 1
        fi
    fi

    cd ../$community_folder
    echo -e "\n~~ Community"
    if [[ $community_exists -eq 1 ]]; then
        git switch $branch
    else
        fetch_if_necessary_switch $branch_source
    fi

    cd ../$enterprise_folder
    echo -e "\n~~ Enterprise"
    if [[ $enterprise_exists -eq 1 ]]; then
        git switch $branch
    else
        fetch_if_necessary_switch $branch_source
    fi
else
    cdodoo
    exit_status=$?
    if [[ $exit_status -ne 0 ]]; then
        exit $exit_status
    fi
    echo -e "\n~~ Community"
    fetch_if_necessary_switch $branch
    cd ../$enterprise_folder
    echo -e "\n~~ Enterprise"
    fetch_if_necessary_switch $branch
fi
