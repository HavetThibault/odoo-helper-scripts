#!/bin/bash

set -e

O_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${O_SCRIPT_DIR}/git_utils.sh"
source "${O_SCRIPT_DIR}/odoo_utils.sh"
source "${O_SCRIPT_DIR}/config.sh"

start_file="$O_SCRIPT_DIR/nicer_logs_please.py"
o_help_file="$O_SCRIPT_DIR/o_help.txt"
previous_config_file="previous_config.txt"
filestore_path="$HOME/.local/share/Odoo/filestore"

to_append_command=""

parse_args() {
    local i=0
    local all_args=($*)
    local args_len=${#all_args[*]}
    # local args_len_less_one=$((args_len-1))
    local args=(${all_args[*]:0:((args_len-2))})
    local is_config_file=${all_args[*]: -2:1}
    local -n cleansed_args=${all_args[*]: -1}
    while [[ $i -lt $((args_len-2)) ]]; do
        if [[ ${args[i]} == '-i' || ${args[i]} == '-di' || ${args[i]} == '-u' || ${args[i]} == '-r' ]]; then
            if [[ $is_config_file -eq 1 ]]; then
                echo "No action expected in the config file, found ${args[i]}" 1>&2
                exit 1
            fi
            cleansed_args[action]=${args[i]}
        elif [[ ${args[i]} == '-m' ]]; then
            if [[ ${args[((i+1))]} =~ ^-.*$ || ${args[((i+1))]} == '' ]]; then
                echo "Module expected after -m" 1>&2
                exit 1
            else
                cleansed_args[action_modules]=${args[((i+1))]}
                i=$((i+1))
            fi
        elif [[ ${args[i]} == '-d' ]]; then
            if [[ ${args[((i+1))]} =~ ^-.*$ || ${args[((i+1))]} == '' ]]; then
                echo "Database expected after -d" 1>&2
                exit 1
            fi
            cleansed_args[database]=${args[((i+1))]}
            i=$((i+1))
        elif [[ ${args[i]} == '-nd' || ${args[i]} == '-dw' || ${args[i]} == '-ndw' ]]; then
            cleansed_args[debug]=${args[i]}
        elif [[ ${args[i]} == '-t' ]]; then
            if [[ ${args[((i+1))]} == '' ]]; then
                echo "No arg found after ${args[i]}" 1>&2
                exit 1
            fi
            cleansed_args[test]=${args[((i+1))]}
            i=$((i+1))
        elif [[ ${args[i]} == '--log-level' ]]; then
            if [[ ${args[((i+1))]} == '' ]]; then
                echo "No arg found after ${args[i]}" 1>&2
                exit 1
            fi
            cleansed_args[log_level]=${args[((i+1))]}
            i=$((i+1))
        elif [[ $i -eq 0 && ${args[i]} == 'shell' ]]; then
            cleansed_args[shell]="1"
        elif [[ $i -eq 0 && ${args[i]} == 'query' ]]; then
            cleansed_args[query]="1"
        elif [[ ${args[i]} == '--login' ]]; then
            if [[ ${args[((i+1))]} == '' ]]; then
                echo "No arg found after ${args[i]}" 1>&2
                exit 1
            fi
            cleansed_args[login]=${args[((i+1))]}
        elif [[ ${args[i]} == '--password' ]]; then
            if [[ ${args[((i+1))]} == '' ]]; then
                echo "No arg found after ${args[i]}" 1>&2
                exit 1
            fi
            cleansed_args[password]=${args[((i+1))]}
        elif [[ ${args[i]} == '-nc' ]]; then
            cleansed_args[no_chrome]="1"
        elif [[ ${args[i]} == '-ur' ]]; then
            if [[ ${args[((i+1))]} == '' ]]; then
                echo "No arg found after ${args[i]}" 1>&2
                exit 1
            fi
            cleansed_args[upgrade_file]=${args[((i+1))]}
            i=$((i+1))
        else
            to_append_command="$to_append_command ${args[i]}"
            if [[ ${args[((i+1))]} != '' && ! ${args[((i+1))]} =~ ^-.*$ ]]; then
                to_append_command="$to_append_command ${args[((i+1))]}"
                i=$((i+1))
            fi
        fi
        i=$((i+1))
    done
}

function get_upgrade_args() {
    local upgrade_file=$1
    local -n cleansed_args=$2
    local args=""
    for upgrade_line in $(cat $upgrade_file); do
        entry=${upgrade_line%%'='*}
        value=${upgrade_line##*'='}
        if [[ $entry == 'src_branch' ]]; then
            cleansed_args[src_branch]=$value
        elif [[ $entry == 'dst_branch' ]]; then
            cleansed_args[dst_branch]=$value
        elif [[ $entry == 'template_db' ]]; then
            cleansed_args[template_db]=$value
        else
            echo "Stfu is this entry bro ?  ---> $entry <---" 1>&2
            return 1
        fi
    done
}

function db_exists() {
    local database=$1
    db_literal="'"$database"'"
    db_exists=$(psql -tAc "SELECT 1 FROM pg_database WHERE datname=$db_literal;")
    if [[ $db_exists == '1' ]]; then
        echo 1
    else
        echo 0
    fi
}

function dropdb_if_exists() {
    local database=$1
    if [[ $(db_exists $database) -eq 1 ]]; then
        dropdb $database
    fi
}

function add_debug_args() {
    local -n ref_parsed_args=$1
    if [[ ${ref_parsed_args[debug]} == '' ]]; then
        ref_parsed_args[debug]='-nd'
    fi

    if [[ ${ref_parsed_args[debug]} == '-nd' ]]; then
        return 0
    fi

    local command=' -m debugpy --listen 0.0.0.0:5699'
    if [[ ${ref_parsed_args[debug]} == '-dw' ]]; then
        command="$command --wait-for-client"
    fi
    echo "$command"
}

function add_log_args() {
    local -n ref_parsed_args=$1
    if [[ ${ref_parsed_args[log_level]} == '' ]]; then
        ref_parsed_args[log_level]=warn
    fi
    echo " --log-level ${ref_parsed_args[log_level]}"
}

function add_addons_args() {
    echo " --addons-path ./addons/,../$enterprise_folder/"
}

function add_db_addons_args() {
    local -n ref_parsed_args=$1
    echo "$(add_addons_args)" -d "${ref_parsed_args[database]}"
}

declare -a cli_args
i=0
# Only strategy I found to convert $* into an indexed array
for arg in $*; do
    if [[ $arg == '--help' ]]; then
        cat $o_help_file
        exit 0
    fi
    cli_args[$i]="$arg"
    i=$((i+1))
done

root_relativ_path=$(get_root_relative_path)
if [[ $root_relativ_path == '' ]]; then
    exit 1
fi

if [[ $1 == 'requirements' ]]; then
    command="-m pip install --force-reinstall -r $root_relativ_path/$community_folder/requirements.txt"
    if [[ $# -ge 2 ]]; then
        if [[ $# -eq 2 && -f ${cli_args[1]} ]]; then
            command="$command -r" ${cli_args[1]}
        else
            if [[ -f "temp_dep_file.txt" ]]; then
                rm temp_dep_file.txt
            fi
            for dep in ${cli_args[@]:1}; do
                echo "$dep" >> temp_dep_file.txt
            done
            cat temp_dep_file.txt
            command="$command -r temp_dep_file.txt"
        fi
    fi
    python_env $command
    if [[ -f temp_dep_file.txt ]]; then
        rm temp_dep_file.txt
    fi
    exit 0
elif [[ $1 == 'pip' ]]; then
    python_env -m pip ${@:2}
    exit 0
elif [[ $1 == 'tblame' ]]; then
    if [[ $# -ne 2 ]]; then
        echo "Only 1 arg is allowed after 'tblame' and it should be the path of the file!" 1>&2
        exit 1
    fi
    # TODO: accept absolute path
    filePath=$2
    community_match="^$community_folder/.*"'$'
    enterprise_match="^$enterprise_folder/.*"'$'
    upgrade_match="^$upgrade_folder/.*"'$'
    if [[ $filePath =~ $community_match ]]; then
        cd $root_relativ_path/$community_folder
        filePath=${filePath#*'/'}
    elif [[ $filePath =~ $enterprise_match ]]; then
        cd $root_relativ_path/$enterprise_folder
        filePath=${filePath#*'/'}
    elif [[ $filePath =~ $upgrade_match ]]; then
        cd $root_relativ_path/$upgrade_folder
        filePath=${filePath#*'/'}
    fi
    tig blame $filePath
    exit 0
fi


cd $root_relativ_path
if [[ $# -eq 0 ]]; then
    if [[ ! -f $previous_config_file ]]; then
        echo Arguments please! Do you really expect it to magically work without any argument? 1>&2
        exit 1
    fi
    config_file=$(cat $previous_config_file)
else
    if [[ ! ${cli_args[0]} =~ ^.*\.txt$ ]]; then
        if [[ ! -f $previous_config_file ]]; then
            echo The first argument must be the config file 1>&2
            exit 1
        else
            config_file=$(cat $previous_config_file)
        fi
    else
        config_file=${cli_args[0]}
        cli_args=(${cli_args[@]:1})
    fi
fi
[[ -e "$previous_config_file" ]] && rm $previous_config_file
echo $config_file > $previous_config_file

# UPGRADE
if [[ ${cli_args[0]} == 'upg' ]]; then
    upg_action=${cli_args[1]}
    if [[ $upg_action != 'init' && $upg_action != 'prep' && $upg_action != 'template' && $upg_action != 'upg' && $upg_action != 'test' ]]; then
        echo "Expected one argument after the 'upg' (prep, upg or test)"  1>&2
        exit 1
    fi
    cli_args=(${cli_args[@]:2})
fi

args=""
for config_line in $(cat $config_file); do
    args="$args $config_line"
done

declare -A parsed_args
parse_args $args 1 parsed_args
parse_args ${cli_args[@]} 0 parsed_args

if [[ ${parsed_args[database]} == '' ]]; then
    echo The database is missing 1>&2
    exit 1
fi

if [[ ${parsed_args[query]} == "1" ]]; then
    # List Category Rules
    if [[ $2 == 'lcr' ]]; then
        if [[ $# -ne 5 ]]; then
            echo "Expected 'category_code' - 'country_code' - 'struct_xmlid' after 'lcr' " 1>&2
            exit 1
        fi
        struct=$5
        struct_module=${struct%%'.'*}
        struct_name=${struct##*'.'}
        psql -c "WITH struct_id AS (
            SELECT d.res_id
                FROM ir_model_data d
                JOIN hr_payroll_structure r ON d.res_id = r.id
                WHERE d.module = '"$struct_module"' AND d.name = '"$struct_name"'
                LIMIT 1)\

            SELECT s.code, s.sequence FROM hr_salary_rule_category c \
            JOIN hr_salary_rule_hr_salary_rule_category_rel crs ON (crs.hr_salary_rule_category_id = c.id AND c.code = '"$3"') \
            JOIN hr_salary_rule s ON (s.id = crs.hr_salary_rule_id) \
            JOIN res_country country ON (country.id = s.country_id AND country.code = '"$4"') \
            JOIN hr_payroll_structure_hr_salary_rule_rel pssr ON (pssr.hr_salary_rule_id = s.id)
            JOIN hr_payroll_structure ps ON (ps.id = pssr.hr_payroll_structure_id AND ps.id IN (SELECT res_id FROM struct_id))\
            ORDER BY s.sequence, s.code" ${parsed_args[database]}
    else
        echo Missing additionnal parameters for 'query'
        exit 1
    fi
    exit 0
fi

if [[ $upg_action != '' ]]; then
    if [[ ${parsed_args[upgrade_file]} == '' ]]; then
        echo 'Missing the upgrade file (-ur <file>)' 1>&2
        exit 1
    fi
    declare -A upgrade_args
    get_upgrade_args ${parsed_args[upgrade_file]} upgrade_args

    cd $community_folder
    export PYTHONPATH="$(pwd):${PYTHONPATH:-}"

    command="$(add_debug_args parsed_args)"
    command="$command $start_file"
    command="$command$(add_addons_args parsed_args)"
    command="$command$(add_log_args parsed_args)"
    command="$command --upgrade-path=../upgrade-util/src,../upgrade/migrations"
    command="$command -nc"

    if [[ $upg_action == 'init' ]]; then
        gswa "${upgrade_args[src_branch]}"
        dropdb_if_exists ${parsed_args[database]}
        if [[ ${parsed_args[action_modules]} == '' ]]; then
            echo The modules are missing 1>&2
            exit 1
        fi
        echo python $command -i ${parsed_args[action_modules]} -d ${parsed_args[database]} --stop-after-init
        if [[ ${parsed_args[debug]} == '-dw' ]]; then
            echo WAITING FOR DEBUGGER ATTACHMENT
        fi
        python_env $command -i ${parsed_args[action_modules]} -d ${parsed_args[database]} --stop-after-init
    elif [[ $upg_action == 'template' ]]; then
        dropdb_if_exists ${upgrade_args[template_db]}
        createdb -T ${parsed_args[database]} ${upgrade_args[template_db]}
        filestore_db="$filestore_path/${upgrade_args[template_db]}"
        if [[ -d "$filestore_db" ]]; then
            chmod -R u+w "$filestore_db"
            rm -R "$filestore_db"
        fi
        cp -R "$filestore_path/${parsed_args[database]}" "$filestore_db"
    elif [[ $upg_action == 'prep' ]]; then
        gswa "${upgrade_args[src_branch]}"
        if [[ $(db_exists ${upgrade_args[template_db]}) -eq 0 ]]; then
            echo Please create the template DB by running \'upg template\' before proceeding to the test preparations! 1>&2
            exit 1
        fi
        echo python $command --test-tags upgrade.test_prepare -d ${upgrade_args[template_db]}
        if [[ ${parsed_args[debug]} == '-dw' ]]; then
            echo WAITING FOR DEBUGGER ATTACHMENT
        fi
        python_env $command --test-tags upgrade.test_prepare -d ${upgrade_args[template_db]}
    elif [[ $upg_action == 'upg' ]]; then
        gswa "${upgrade_args[dst_branch]}"
        echo python $command -u all -d ${upgrade_args[template_db]} --stop-after-init
        if [[ ${parsed_args[debug]} == '-dw' ]]; then
            echo WAITING FOR DEBUGGER ATTACHMENT
        fi
        python_env $command -u all -d ${upgrade_args[template_db]} --stop-after-init
    elif [[ $upg_action == 'test' ]]; then
        gswa "${upgrade_args[dst_branch]}"
        echo python $command --test-tags upgrade.test_check -d ${upgrade_args[template_db]}
        if [[ ${parsed_args[debug]} == '-dw' ]]; then
            echo WAITING FOR DEBUGGER ATTACHMENT
        fi
        python_env $command --test-tags upgrade.test_check -d ${upgrade_args[template_db]}
    fi
    exit 0
fi

command="$command$(add_debug_args parsed_args)"

if [[ ${parsed_args[action]} == '-di' ]]; then
    dropdb_if_exists ${parsed_args[database]}
    parsed_args[action]=-i
elif [[ ${parsed_args[action]} == '' || ${parsed_args[action]} == '-r' || ${parsed_args[action]} == '-u' ]]; then
    db_exists=$(psql -c "SELECT 'EXISTS' as exists;" ${parsed_args[database]} | head -n 1)
    db_exists_pattern="^ exists.*$"
    if [[ ! $db_exists =~ $db_exists_pattern ]]; then
        parsed_args[action]='-i'
    fi
fi

command="$command $start_file"

if [[ ${parsed_args[shell]} == "1" ]]; then
    command="$command shell"
fi

command="$command$(add_db_addons_args parsed_args)"

if [[ ${parsed_args[action]} != '' && ${parsed_args[action]} != '-r' ]]; then
    if [[ ${parsed_args[action_modules]} == '' ]]; then
        echo The modules are missing 1>&2
        exit 1
    fi
    command="$command ${parsed_args[action]} ${parsed_args[action_modules]}"
fi

if [[ ${parsed_args[test]} != '' ]]; then
    command="$command --test-tags ${parsed_args[test]} --stop-after-init"
fi

command="$command$(add_log_args parsed_args)"
command="$command $to_append_command"

if [[ ${parsed_args[no_chrome]} == '1' ]]; then
    command="$command -nc"
fi

if [[ ${parsed_args[login]} != '' ]]; then
    command="$command --login ${parsed_args[login]}"
else
    command="$command --login $default_login"
fi

if [[ ${parsed_args[password]} != '' ]]; then
    command="$command --password ${parsed_args[password]}"
else
    command="$command --password $default_password"
fi

if [[ $enable_chrome_managmenent == '0' ]]; then
    command="$command -nc"
fi

cd $community_folder
export PYTHONPATH="$(pwd):${PYTHONPATH:-}"
echo "python $command"
if [[ ${parsed_args[debug]} == '-dw' ]]; then
    echo WAITING FOR DEBUGGER ATTACHMENT
fi
python_env $command
